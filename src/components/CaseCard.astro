---
import Icon from './Icon.astro';
import type { Case } from '../data/cases';

interface Props {
    item: Case;
}

const { item } = Astro.props;
---
<article class="case-card">
    <div class="case-card__top">
        <span class="case-card__icon"><Icon name={item.icon} size={20} /></span>
        <span class="case-card__tag">{item.solution.name}</span>
    </div>
    <span class="case-card__client">{item.client}</span>
    <h3><a href={`/cases/#${item.id}`}>{item.title}</a></h3>
    <p>{item.summary}</p>
    <span class="link-arrow" aria-hidden="true">Ver o case <Icon name="ArrowRight" size={16} /></span>
</article>

<style>
    .case-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 2rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        transition: border-color 0.15s ease;
    }

    .case-card:hover {
        border-color: var(--line-strong);
    }

    .case-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .case-card__icon {
        display: inline-grid;
        place-items: center;
        width: 40px;
        height: 40px;
        border-radius: var(--radius);
        background: var(--brand-tint);
        color: var(--brand-ink);
    }

    .case-card__tag {
        padding: 0.25rem 0.625rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--ink-2);
    }

    .case-card__client {
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand-ink);
    }

    .case-card h3 {
        margin-top: 0.5rem;
        font-size: var(--text-lg);
    }

    .case-card h3 a {
        color: inherit;
        text-decoration: none;
    }

    .case-card h3 a::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    .case-card h3 a:focus-visible {
        outline: none;
    }

    .case-card:has(h3 a:focus-visible) {
        outline: 2px solid var(--brand);
        outline-offset: 3px;
    }

    .case-card p {
        margin-top: 0.625rem;
        color: var(--muted);
        font-size: var(--text-sm);
        flex-grow: 1;
    }

    .case-card .link-arrow {
        margin-top: 1.25rem;
        color: var(--brand-ink);
    }
</style>
