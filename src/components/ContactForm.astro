---
// Formulário de contato enviado direto à API de formulários do HubSpot
// (sem script do HubSpot na página, portanto sem cookies novos).
// Os nomes dos campos precisam existir no formulário criado no HubSpot.
import { site } from '../site';

const segments = ['Varejo ou marketplace', 'ERP ou SaaS', 'Gig ou creator economy', 'Outro'];
const baseSizes = ['Até 1 mil clientes', '1 mil a 10 mil clientes', '10 mil a 100 mil clientes', 'Mais de 100 mil clientes'];
const consentText =
    'Concordo que a Brücken trate os dados acima para responder ao meu contato, conforme a Política de Privacidade.';
---
<form
    class="contact-form"
    id="contact-form"
    novalidate
    data-portal-id={site.hubspot.portalId}
    data-form-id={site.hubspot.formId}
    data-consent-text={consentText}
    data-success-url="/contato/obrigado/"
    data-whatsapp={site.whatsappUrl}
>
    <div class="field-row">
        <div class="field">
            <label for="cf-name">Nome</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
            <label for="cf-email">E-mail corporativo</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
    </div>

    <div class="field">
        <label for="cf-company">Empresa / plataforma</label>
        <input id="cf-company" name="company" type="text" autocomplete="organization" required />
    </div>

    <div class="field-row">
        <div class="field">
            <label for="cf-segment">Segmento</label>
            <select id="cf-segment" name="segmento" required>
                <option value="" selected disabled>Selecione</option>
                {segments.map((s) => <option>{s}</option>)}
            </select>
        </div>
        <div class="field">
            <label for="cf-size">Tamanho da base de clientes</label>
            <select id="cf-size" name="tamanho_da_base" required>
                <option value="" selected disabled>Selecione</option>
                {baseSizes.map((s) => <option>{s}</option>)}
            </select>
        </div>
    </div>

    <div class="field">
        <label for="cf-message">O que você quer avaliar? <span class="optional">(opcional)</span></label>
        <textarea id="cf-message" name="message" rows="4"></textarea>
    </div>

    <!-- Armadilha para robôs: humanos não veem este campo -->
    <div class="hp" aria-hidden="true">
        <label for="cf-website">Site</label>
        <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
            Concordo que a Brücken trate os dados acima para responder ao meu contato, conforme a{' '}
            <a href={site.privacyUrl} target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.
        </span>
    </label>

    <p class="form-error" role="alert" hidden></p>

    <button type="submit" class="btn btn--primary contact-form__submit">Enviar</button>
</form>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const errorBox = form.querySelector<HTMLParagraphElement>('.form-error')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const whatsapp = form.dataset.whatsapp;

    function showError(message: string) {
        errorBox.innerHTML = message;
        errorBox.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.hidden = true;

        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            form.querySelector<HTMLElement>(':invalid')?.focus();
            showError('Preencha os campos obrigatórios e aceite a Política de Privacidade para enviar.');
            return;
        }

        const data = new FormData(form);
        if (data.get('website')) return; // robô

        const { portalId, formId, consentText, successUrl } = form.dataset;
        if (!portalId || !formId) {
            showError(
                `O formulário ainda não está configurado. Fale com a gente pelo <a href="${whatsapp}" target="_blank" rel="noopener noreferrer">WhatsApp</a>.`,
            );
            return;
        }

        const fullName = String(data.get('name')).trim();
        const [firstname, ...rest] = fullName.split(/\s+/);
        const fields = [
            { name: 'firstname', value: firstname },
            { name: 'lastname', value: rest.join(' ') },
            { name: 'email', value: String(data.get('email')).trim() },
            { name: 'company', value: String(data.get('company')).trim() },
            { name: 'segmento', value: String(data.get('segmento')) },
            { name: 'tamanho_da_base', value: String(data.get('tamanho_da_base')) },
            { name: 'message', value: String(data.get('message') ?? '').trim() },
        ].filter((f) => f.value);

        submit.disabled = true;
        submit.textContent = 'Enviando…';

        try {
            const response = await fetch(
                `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formId}`,
                {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fields,
                        context: { pageUri: location.href, pageName: document.title },
                        legalConsentOptions: {
                            consent: { consentToProcess: true, text: consentText, communications: [] },
                        },
                    }),
                },
            );
            if (!response.ok) throw new Error(`HubSpot ${response.status}`);

            window.gtag?.('event', 'generate_lead', {
                segmento: data.get('segmento'),
                tamanho_da_base: data.get('tamanho_da_base'),
            });
            location.href = successUrl!;
        } catch (err) {
            console.error(err);
            showError(
                `Não conseguimos enviar agora. Tente de novo em instantes ou fale com a gente pelo <a href="${whatsapp}" target="_blank" rel="noopener noreferrer">WhatsApp</a>.`,
            );
            submit.disabled = false;
            submit.textContent = 'Enviar';
        }
    });
</script>

<style>
    .contact-form {
        display: grid;
        gap: 1.25rem;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .field {
        display: grid;
        gap: 0.375rem;
    }

    .field label {
        color: var(--ink);
        font-size: var(--text-sm);
        font-weight: 600;
    }

    .optional {
        color: var(--muted);
        font-weight: 400;
    }

    .field input,
    .field select,
    .field textarea {
        width: 100%;
        min-height: 44px;
        padding: 0.625rem 0.75rem;
        font: inherit;
        font-size: var(--text-base);
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius);
        transition: border-color 0.15s ease;
    }

    .field textarea {
        resize: vertical;
    }

    .field input:focus-visible,
    .field select:focus-visible,
    .field textarea:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 1px;
        border-color: var(--brand);
    }

    .was-validated :is(input, select):invalid {
        border-color: #B42318;
    }

    .hp {
        position: absolute;
        left: -9999px;
    }

    .consent {
        display: flex;
        gap: 0.75rem;
        align-items: start;
        font-size: var(--text-sm);
        color: var(--ink-2);
    }

    .consent input {
        flex: none;
        width: 18px;
        height: 18px;
        margin-top: 0.15rem;
        accent-color: var(--ink);
    }

    .was-validated .consent input:invalid + span {
        color: #B42318;
    }

    .form-error {
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        background: #FEF3F2;
        color: #B42318;
        font-size: var(--text-sm);
    }

    .form-error :global(a) {
        color: inherit;
        font-weight: 600;
    }

    .contact-form__submit {
        justify-self: start;
        min-width: 160px;
    }

    @media (max-width: 640px) {
        .field-row {
            grid-template-columns: 1fr;
        }

        .contact-form__submit {
            justify-self: stretch;
        }
    }
</style>
