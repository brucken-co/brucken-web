---
// Formulário de contato enviado direto à API de formulários do HubSpot
// (sem script do HubSpot na página, portanto sem cookies novos).
// Os campos espelham o formulário "Contato Site" do HubSpot: objectTypeId 0-1 = Contato, 0-2 = Empresa.
import { site } from '../site';

const segments = ['Varejo ou marketplace', 'ERP ou SaaS', 'Gig ou creator economy', 'Outro'];
const customerTypes = [
    { value: 'PF', label: 'Pessoas físicas (PF)' },
    { value: 'PJ', label: 'Empresas (PJ)' },
];
const consentText =
    'Concordo que a Brücken trate os dados acima para responder ao meu contato, conforme a Política de Privacidade.';
---
<form
    class="contact-form"
    id="contact-form"
    novalidate
    data-portal-id={site.hubspot.portalId}
    data-form-id={site.hubspot.formId}
    data-consent-text={consentText}
    data-success-url="/contato/obrigado/"
    data-whatsapp={site.whatsappUrl}
>
    <div class="field-row">
        <div class="field">
            <label for="cf-firstname">Nome</label>
            <input id="cf-firstname" name="firstname" type="text" autocomplete="given-name" required />
        </div>
        <div class="field">
            <label for="cf-lastname">Sobrenome</label>
            <input id="cf-lastname" name="lastname" type="text" autocomplete="family-name" required />
        </div>
    </div>

    <div class="field-row">
        <div class="field">
            <label for="cf-email">E-mail corporativo</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
            <label for="cf-phone">Telefone <span class="optional">(opcional)</span></label>
            <div class="phone">
                <span class="phone__prefix" aria-hidden="true">🇧🇷 +55</span>
                <input
                    id="cf-phone"
                    name="phone"
                    type="tel"
                    autocomplete="tel-national"
                    inputmode="tel"
                    placeholder="(11) 99999-9999"
                    pattern="[0-9()+\-\s]{8,20}"
                    aria-describedby="cf-phone-hint"
                />
            </div>
            <span id="cf-phone-hint" class="visually-hidden">Número do Brasil com DDD. Para outro país, comece com + e o código do país.</span>
        </div>
    </div>

    <div class="field">
        <label for="cf-company">Nome da empresa</label>
        <input id="cf-company" name="nome_da_empresa" type="text" autocomplete="organization" required />
    </div>

    <div class="field">
        <label for="cf-segment">Segmento</label>
        <select id="cf-segment" name="segmento" required>
            <option value="" selected disabled>Selecione</option>
            {segments.map((s) => <option>{s}</option>)}
        </select>
    </div>

    <div class="field-row">
        <div class="field">
            <label for="cf-type">Seus clientes são</label>
            <select id="cf-type" name="tipo_de_clientes" required>
                <option value="" selected disabled>Selecione</option>
                {customerTypes.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
        </div>
        <div class="field">
            <label for="cf-size">Número aproximado de clientes</label>
            <input id="cf-size" name="tamanho_de_base" type="number" inputmode="numeric" min="0" step="1" placeholder="Ex.: 5000" required />
        </div>
    </div>

    <div class="field">
        <label for="cf-message">O que você quer avaliar? <span class="optional">(opcional)</span></label>
        <textarea id="cf-message" name="message" rows="4"></textarea>
    </div>

    <!-- Armadilha para robôs: humanos não veem este campo -->
    <div class="hp" aria-hidden="true">
        <label for="cf-website">Site</label>
        <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <label class="consent">
        <input type="checkbox" name="consent" required />
        <span>
            Concordo que a Brücken trate os dados acima para responder ao meu contato, conforme a{' '}
            <a href={site.privacyUrl} target="_blank" rel="noopener noreferrer">Política de Privacidade</a>.
        </span>
    </label>

    <p class="form-error" role="alert" hidden></p>

    <button type="submit" class="btn btn--primary contact-form__submit">Enviar</button>
</form>

<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const errorBox = form.querySelector<HTMLParagraphElement>('.form-error')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const whatsapp = form.dataset.whatsapp;

    // Brasil (+55) por padrão; números que já começam com + são mantidos
    function normalizePhone(raw: string) {
        if (!raw) return '';
        if (raw.startsWith('+')) return '+' + raw.slice(1).replace(/\D/g, '');
        const digits = raw.replace(/\D/g, '').replace(/^0+/, '');
        return digits ? `+55${digits}` : '';
    }

    function showError(message: string) {
        errorBox.innerHTML = message;
        errorBox.hidden = false;
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.hidden = true;

        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            form.querySelector<HTMLElement>(':invalid')?.focus();
            showError('Preencha os campos obrigatórios e aceite a Política de Privacidade para enviar.');
            return;
        }

        const data = new FormData(form);
        if (data.get('website')) return; // robô

        const { portalId, formId, consentText, successUrl } = form.dataset;
        if (!portalId || !formId) {
            showError(
                `O formulário ainda não está configurado. Fale com a gente pelo <a href="${whatsapp}" target="_blank" rel="noopener noreferrer">WhatsApp</a>.`,
            );
            return;
        }

        const value = (name: string) => String(data.get(name) ?? '').trim();
        const contact = (name: string, v = value(name)) => ({ objectTypeId: '0-1', name, value: v });
        const company = (name: string, v = value(name)) => ({ objectTypeId: '0-2', name, value: v });
        const fields = [
            contact('firstname'),
            contact('lastname'),
            contact('email'),
            contact('phone', normalizePhone(value('phone'))),
            contact('message'),
            company('nome_da_empresa'),
            company('segmento'),
            company('tipo_de_clientes'),
            company('tamanho_de_base'),
        ].filter((f) => f.value);

        submit.disabled = true;
        submit.textContent = 'Enviando…';

        try {
            const response = await fetch(
                `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formId}`,
                {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        fields,
                        context: { pageUri: location.href, pageName: document.title },
                        legalConsentOptions: {
                            consent: { consentToProcess: true, text: consentText, communications: [] },
                        },
                    }),
                },
            );
            if (!response.ok) throw new Error(`HubSpot ${response.status}`);

            window.gtag?.('event', 'generate_lead', {
                segmento: data.get('segmento'),
                tipo_de_clientes: data.get('tipo_de_clientes'),
            });
            location.href = successUrl!;
        } catch (err) {
            console.error(err);
            showError(
                `Não conseguimos enviar agora. Tente de novo em instantes ou fale com a gente pelo <a href="${whatsapp}" target="_blank" rel="noopener noreferrer">WhatsApp</a>.`,
            );
            submit.disabled = false;
            submit.textContent = 'Enviar';
        }
    });
</script>

<style>
    .contact-form {
        display: grid;
        gap: 1.25rem;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .field {
        display: grid;
        gap: 0.375rem;
    }

    .field label {
        color: var(--ink);
        font-size: var(--text-sm);
        font-weight: 600;
    }

    .optional {
        color: var(--muted);
        font-weight: 400;
    }

    .field input,
    .field select,
    .field textarea {
        width: 100%;
        min-height: 44px;
        padding: 0.625rem 0.75rem;
        font: inherit;
        font-size: var(--text-base);
        color: var(--ink);
        background: var(--bg);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius);
        transition: border-color 0.15s ease;
    }

    .field textarea {
        resize: vertical;
    }

    .phone {
        display: flex;
        align-items: stretch;
    }

    .phone__prefix {
        display: inline-flex;
        align-items: center;
        padding: 0 0.75rem;
        border: 1px solid var(--line-strong);
        border-right: 0;
        border-radius: var(--radius) 0 0 var(--radius);
        background: var(--bg-subtle);
        color: var(--ink-2);
        font-size: var(--text-sm);
        white-space: nowrap;
    }

    .phone input {
        border-radius: 0 var(--radius) var(--radius) 0;
    }

    .field input:focus-visible,
    .field select:focus-visible,
    .field textarea:focus-visible {
        outline: 2px solid var(--brand);
        outline-offset: 1px;
        border-color: var(--brand);
    }

    .was-validated :is(input, select):invalid {
        border-color: #B42318;
    }

    .hp {
        position: absolute;
        left: -9999px;
    }

    .consent {
        display: flex;
        gap: 0.75rem;
        align-items: start;
        font-size: var(--text-sm);
        color: var(--ink-2);
    }

    .consent input {
        flex: none;
        width: 18px;
        height: 18px;
        margin-top: 0.15rem;
        accent-color: var(--ink);
    }

    .was-validated .consent input:invalid + span {
        color: #B42318;
    }

    .form-error {
        padding: 0.75rem 1rem;
        border-radius: var(--radius);
        background: #FEF3F2;
        color: #B42318;
        font-size: var(--text-sm);
    }

    .form-error :global(a) {
        color: inherit;
        font-weight: 600;
    }

    .contact-form__submit {
        justify-self: start;
        min-width: 160px;
    }

    @media (max-width: 640px) {
        .field-row {
            grid-template-columns: 1fr;
        }

        .contact-form__submit {
            justify-self: stretch;
        }
    }
</style>
