---
import { site } from '../site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <img src={site.logo} alt="Brücken" width="111" height="52" loading="lazy" />
                <p>Motor de decisão e consultoria de crédito embarcado para plataformas B2B.</p>
            </div>

            <nav aria-label="Soluções">
                <h2>Soluções</h2>
                <ul role="list">
                    <li><a href="/#solucoes">Consultoria de crédito</a></li>
                    <li><a href="/#solucoes">Motor de decisão</a></li>
                    <li><a href="/#solucoes">Full service</a></li>
                </ul>
            </nav>

            <nav aria-label="Empresa">
                <h2>Empresa</h2>
                <ul role="list">
                    <li><a href="/#como-funciona">Como funciona</a></li>
                    <li><a href="/#setores">Setores</a></li>
                    <li><a href={site.privacyUrl}>Privacidade (LGPD)</a></li>
                </ul>
            </nav>

            <nav aria-label="Contato">
                <h2>Contato</h2>
                <ul role="list">
                    <li><a href={site.bookingUrl} target="_blank" rel="noopener noreferrer" data-track="footer">Agendar conversa</a></li>
                    <li><a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" data-track="footer">WhatsApp</a></li>
                    <li><a href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                </ul>
            </nav>
        </div>

        <div class="site-footer__legal">
            <p>&copy; {year} Brücken. Todos os direitos reservados.</p>
            <a href="#" data-cookie-settings>Preferências de cookies</a>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        border-top: 1px solid var(--line);
        padding-block: 4rem 2rem;
        font-size: var(--text-sm);
    }

    .site-footer__grid {
        display: grid;
        grid-template-columns: 2fr repeat(3, 1fr);
        gap: 2.5rem;
    }

    .site-footer__brand img {
        height: 52px;
        width: auto;
        margin-bottom: 1rem;
    }

    .site-footer__brand p {
        max-width: 300px;
        color: var(--muted);
    }

    .site-footer h2 {
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: 1rem;
    }

    .site-footer li + li {
        margin-top: 0.625rem;
    }

    .site-footer a {
        color: var(--muted);
        text-decoration: none;
    }

    .site-footer a:hover {
        color: var(--ink);
    }

    .site-footer__legal {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: var(--text-xs);
    }

    @media (max-width: 760px) {
        .site-footer__grid {
            grid-template-columns: 1fr 1fr;
        }

        .site-footer__brand {
            grid-column: 1 / -1;
        }
    }
</style>
