---
import Icon from './Icon.astro';
import type { Sector } from '../data/sectors';

interface Props {
    sector: Sector;
}

const { sector } = Astro.props;
---
<article class="sector-card">
    <span class="sector-card__icon"><Icon name={sector.icon} size={22} /></span>
    <h3><a href={`/setores/${sector.slug}/`}>{sector.name}</a></h3>
    <p>{sector.summary}</p>
    <span class="link-arrow" aria-hidden="true">Saiba mais <Icon name="ArrowRight" size={16} /></span>
</article>

<style>
    .sector-card {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: 2rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        transition: border-color 0.15s ease;
    }

    .sector-card:hover {
        border-color: var(--line-strong);
    }

    .sector-card__icon {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 1.25rem;
        border-radius: var(--radius);
        background: var(--brand-tint);
        color: var(--brand-ink);
    }

    .sector-card h3 {
        font-size: var(--text-lg);
    }

    .sector-card h3 a {
        color: inherit;
        text-decoration: none;
    }

    .sector-card h3 a::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
    }

    .sector-card h3 a:focus-visible {
        outline: none;
    }

    .sector-card:has(h3 a:focus-visible) {
        outline: 2px solid var(--brand);
        outline-offset: 3px;
    }

    .sector-card p {
        margin-top: 0.625rem;
        color: var(--muted);
        font-size: var(--text-sm);
        flex-grow: 1;
    }

    .sector-card .link-arrow {
        margin-top: 1.25rem;
        color: var(--brand-ink);
    }
</style>
