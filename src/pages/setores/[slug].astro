---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import SolutionCard from '../../components/SolutionCard.astro';
import Icon from '../../components/Icon.astro';
import { sectors, type Sector } from '../../data/sectors';
import { solutions } from '../../data/solutions';
import { breadcrumbSchema, faqSchema } from '../../schema';

export function getStaticPaths() {
    return sectors.map((sector) => ({ params: { slug: sector.slug }, props: { sector } }));
}

interface Props {
    sector: Sector;
}

const { sector } = Astro.props;
const path = `/setores/${sector.slug}/`;
const breadcrumbs = [
    { label: 'Início', href: '/' },
    { label: 'Setores', href: '/setores/' },
    { label: sector.name },
];
---
<BaseLayout
    title={`${sector.title} - Brücken`}
    description={sector.metaDescription}
    schema={[breadcrumbSchema(breadcrumbs, path), faqSchema(sector.faq)]}
>
    <PageHeader breadcrumbs={breadcrumbs} eyebrow="Setores" title={sector.title} lead={sector.lead} />

    <section class="section">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Aplicações</span>
                <h2>Como o crédito pode funcionar na sua plataforma</h2>
                <p>Exemplos de ofertas de crédito. A política de cada operação define produtos, limites e prazos.</p>
            </div>
            <div class="grid-3">
                {sector.useCases.map((item) => (
                    <article class="use-case">
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="section section--subtle">
        <div class="container split-section">
            <div>
                <span class="eyebrow">Dados</span>
                <h2>O que pode entrar na decisão</h2>
                <p class="signals__note">
                    Exemplos de informações que a sua plataforma já tem. A política define quais delas entram em cada decisão.
                </p>
            </div>
            <ul class="check-list" role="list">
                {sector.signals.map((item) => (
                    <li><Icon name="Database" size={18} />{item}</li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Soluções</span>
                <h2>Como a Brücken ajuda</h2>
                <p>Escolha o formato que combina com o momento da sua operação.</p>
            </div>
            <div class="grid-3">
                {solutions.map((s) => <SolutionCard solution={s} />)}
            </div>
        </div>
    </section>

    <section class="section section--subtle">
        <div class="container split-section">
            <div>
                <span class="eyebrow">Perguntas frequentes</span>
                <h2>Dúvidas comuns</h2>
            </div>
            <Faq items={sector.faq} />
        </div>
    </section>

    <CtaBand track={`setor-${sector.slug}`} />
</BaseLayout>

<style>
    .use-case {
        padding: 1.75rem;
        border-top: 2px solid var(--ink);
    }

    .use-case h3 {
        font-size: var(--text-lg);
    }

    .use-case p {
        margin-top: 0.625rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    .signals__note {
        margin-top: 1rem;
        color: var(--muted);
    }
</style>
