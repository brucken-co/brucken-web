---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { cases } from '../../data/cases';
import { breadcrumbSchema } from '../../schema';

const breadcrumbs = [{ label: 'Início', href: '/' }, { label: 'Cases' }];
---
<BaseLayout
    title="Cases de crédito embarcado - Brücken"
    description="Casos de uso da Brücken: crédito consignado para trabalhadores CLT em uma empresa de benefícios (consultoria) e crédito para motoristas (full service)."
    schema={[breadcrumbSchema(breadcrumbs, '/cases/')]}
>
    <PageHeader
        breadcrumbs={breadcrumbs}
        eyebrow="Cases"
        title="Projetos de crédito que já entregamos"
        lead="Dois projetos em que a Brücken desenhou a política de crédito — e, em um deles, também o software de decisão. Por confidencialidade, os clientes não são identificados."
        cta={false}
    />

    <nav class="case-index container" aria-label="Cases nesta página">
        {cases.map((item, i) => (
            <a href={`#${item.id}`}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item.title}
            </a>
        ))}
    </nav>

    {cases.map((item, i) => (
        <section class:list={['section', 'case', { 'section--subtle': i % 2 === 1 }]} id={item.id} aria-labelledby={`${item.id}-title`}>
            <div class="container case__grid">
                <aside class="case__meta">
                    <span class="case__icon"><Icon name={item.icon} size={24} /></span>
                    <dl>
                        <div>
                            <dt>Cliente</dt>
                            <dd>{item.client}</dd>
                        </div>
                        <div>
                            <dt>Produto</dt>
                            <dd>{item.product}</dd>
                        </div>
                        <div>
                            <dt>Formato</dt>
                            <dd><a href={`/solucoes/${item.solution.slug}/`}>{item.solution.name}</a></dd>
                        </div>
                        {item.sector && (
                            <div>
                                <dt>Setor</dt>
                                <dd><a href={`/setores/${item.sector.slug}/`}>{item.sector.name}</a></dd>
                            </div>
                        )}
                    </dl>
                </aside>

                <div class="case__body">
                    <span class="eyebrow">Case {String(i + 1).padStart(2, '0')}</span>
                    <h2 id={`${item.id}-title`}>{item.title}</h2>
                    <p class="case__summary">{item.summary}</p>

                    <h3>Contexto</h3>
                    <p>{item.context}</p>

                    <h3>O que a Brücken fez</h3>
                    <ul class="check-list" role="list">
                        {item.work.map((w) => (
                            <li><Icon name="Check" size={18} strokeWidth={2} />{w}</li>
                        ))}
                    </ul>

                    <p class="case__role">{item.role}</p>
                </div>
            </div>
        </section>
    ))}

    <CtaBand
        title="Quer um projeto como esses na sua plataforma?"
        track="cases"
    />
</BaseLayout>

<style>
    .case-index {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 2rem;
        padding-block: 1.5rem;
        border-bottom: 1px solid var(--line);
    }

    .case-index a {
        display: inline-flex;
        gap: 0.625rem;
        color: var(--ink);
        font-weight: 600;
        font-size: var(--text-sm);
        text-decoration: none;
    }

    .case-index a:hover {
        color: var(--brand-ink);
    }

    .case-index span {
        font-family: var(--font-mono);
        color: var(--brand-ink);
        font-weight: 400;
    }

    .case__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
        gap: clamp(2rem, 1rem + 4vw, 5rem);
        align-items: start;
    }

    .case__meta {
        position: sticky;
        top: calc(var(--header-h) + 2rem);
        padding: 1.75rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
    }

    .case__icon {
        display: inline-grid;
        place-items: center;
        width: 48px;
        height: 48px;
        margin-bottom: 1.5rem;
        border-radius: var(--radius);
        background: var(--brand-tint);
        color: var(--brand-ink);
    }

    .case__meta dl {
        display: grid;
        gap: 1rem;
    }

    .case__meta dt {
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .case__meta dd {
        margin: 0.25rem 0 0;
        color: var(--ink);
        font-weight: 500;
    }

    .case__body h2 {
        font-size: var(--text-2xl);
    }

    .case__summary {
        margin-top: 1rem;
        font-size: var(--text-lg);
        color: var(--muted);
    }

    .case__body h3 {
        margin-top: 2.5rem;
        margin-bottom: 0.75rem;
        font-size: var(--text-lg);
    }

    .case__body > p:not(.case__summary):not(.case__role) {
        color: var(--ink-2);
    }

    .case__role {
        margin-top: 2rem;
        padding: 1rem 1.25rem;
        border-left: 3px solid var(--accent);
        background: var(--bg-subtle);
        color: var(--ink-2);
        font-size: var(--text-sm);
    }

    .section--subtle .case__role {
        background: var(--bg);
    }

    @media (max-width: 860px) {
        .case__grid {
            grid-template-columns: 1fr;
        }

        .case__meta {
            position: static;
        }
    }
</style>
