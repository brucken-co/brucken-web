---
import BaseLayout from '../layouts/BaseLayout.astro';
import DecisionPanel from '../components/DecisionPanel.astro';
import Icon from '../components/Icon.astro';
import SolutionCard from '../components/SolutionCard.astro';
import SectorCard from '../components/SectorCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { solutions } from '../data/solutions';
import { sectors } from '../data/sectors';
import { site } from '../site';

const facts = [
    { value: '< 300 ms', label: 'para cada decisão de crédito' },
    { value: 'API REST', label: 'ou troca de arquivos, sem mudar seu armazenamento' },
    { value: 'Bureaus', label: 'e múltiplas fontes de dados integradas' },
    { value: 'Sua política', label: 'sob seu controle, com cada decisão rastreável' },
];


const steps = [
    {
        title: 'Conectamos seus dados',
        text: 'Integramos via API ou arquivos às fontes que você já tem. Você não precisa mudar como armazena seus dados.',
    },
    {
        title: 'O crédito aparece na sua plataforma',
        text: 'Seu cliente pede crédito dentro da sua experiência, com a sua marca. A decisão acontece nos bastidores.',
    },
    {
        title: 'Acompanhamos e ajustamos',
        text: 'Cuidamos da qualidade dos dados e da calibração do motor, e revisamos a estratégia com você.',
    },
];

---
<BaseLayout title="Brücken - Crédito na sua plataforma, decidido com os seus dados">
    <!-- Hero -->
    <section class="hero">
        <div class="container hero__grid">
            <div class="hero__copy">
                <span class="eyebrow">Crédito embarcado para plataformas</span>
                <h1>Crédito na sua plataforma, decidido com os seus dados</h1>
                <p class="hero__lead">
                    A Brücken integra um motor de crédito à sua plataforma e usa os dados que você já tem
                    para oferecer crédito sob medida aos seus clientes — sem construir nada do zero.
                </p>
                <div class="hero__actions">
                    <a href={site.bookingUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer" data-track="hero">
                        Agendar conversa <Icon name="ArrowRight" size={18} />
                    </a>
                    <a href="#solucoes" class="btn btn--secondary">Ver soluções</a>
                </div>
            </div>
            <div class="hero__visual">
                <DecisionPanel />
            </div>
        </div>
    </section>

    <!-- Fatos -->
    <section class="facts" aria-label="Em números">
        <div class="container">
            <dl class="facts__grid">
                {facts.map((f) => (
                    <div>
                        <dt>{f.value}</dt>
                        <dd>{f.label}</dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>

    <!-- Proposta -->
    <section class="section">
        <div class="container split">
            <div>
                <span class="eyebrow">Por que a Brücken</span>
                <h2 class="split__title">Seus dados já dizem quem pode receber crédito.</h2>
            </div>
            <div class="split__text">
                <p>
                    Plataformas acumulam informação valiosa sobre seus clientes: o que vendem, com que frequência,
                    quanto faturam. Transformar isso em crédito exige um motor de decisão, uma política de risco
                    e gente que saiba calibrar os dois.
                </p>
                <p>
                    A Brücken entrega as três coisas. Você ganha uma nova linha de receita e mantém o
                    relacionamento com o cliente dentro da sua marca.
                </p>
            </div>
        </div>
    </section>

    <!-- Soluções -->
    <section class="section section--subtle" id="solucoes">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Soluções</span>
                <h2>Três formas de trabalhar juntos</h2>
                <p>Da estruturação da política à operação completa, no ritmo do seu negócio.</p>
            </div>
            <div class="grid-3">
                {solutions.map((s) => <SolutionCard solution={s} />)}
            </div>
            <a href="/solucoes/" class="link-arrow section-more">Conhecer as soluções <Icon name="ArrowRight" size={16} /></a>
        </div>
    </section>

    <!-- Como funciona -->
    <section class="section" id="como-funciona">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Como funciona</span>
                <h2>Do dado à decisão em três etapas</h2>
            </div>
            <ol class="steps" role="list">
                {steps.map((step, i) => (
                    <li class="step">
                        <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- Setores -->
    <section class="section section--subtle" id="setores">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Setores</span>
                <h2>Sua vertical, sua oferta de crédito</h2>
                <p>Adaptamos o motor e a política aos dados que cada tipo de plataforma já gera.</p>
            </div>
            <div class="grid-3">
                {sectors.map((s) => <SectorCard sector={s} />)}
            </div>
        </div>
    </section>

    <CtaBand id="contato" />
</BaseLayout>

<style>
    /* Hero */
    .hero {
        padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
        background:
            linear-gradient(to bottom, transparent 70%, var(--bg)),
            radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px;
    }

    .hero__grid {
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: clamp(2.5rem, 2rem + 3vw, 5rem);
        align-items: center;
    }

    .hero h1 {
        font-size: var(--text-3xl);
        letter-spacing: -0.03em;
    }

    .hero__lead {
        margin-top: 1.5rem;
        max-width: 34rem;
        font-size: var(--text-lg);
        color: var(--muted);
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    /* Fatos */
    .facts {
        border-block: 1px solid var(--line);
    }

    .facts__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .facts__grid > div {
        padding: 2rem 1.5rem;
    }

    .facts__grid > div + div {
        border-left: 1px solid var(--line);
    }

    .facts dt {
        color: var(--ink);
        font-size: var(--text-xl);
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .facts dd {
        margin: 0.375rem 0 0;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    /* Proposta */
    .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(2rem, 1rem + 4vw, 5rem);
    }

    .split__title {
        font-size: var(--text-2xl);
    }

    .split__text {
        font-size: var(--text-lg);
        color: var(--muted);
        display: grid;
        gap: 1.25rem;
        align-content: end;
    }

    /* Como funciona */
    .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 0;
        list-style: none;
    }

    .step {
        padding-top: 1.5rem;
        border-top: 2px solid var(--ink);
    }

    .step__num {
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--brand-ink);
        margin-bottom: 1rem;
    }

    .step h3 {
        font-size: var(--text-lg);
    }

    .step p {
        margin-top: 0.75rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    .section-more {
        margin-top: 2rem;
    }

    /* Responsivo */
    @media (max-width: 960px) {
        .hero__grid,
        .split {
            grid-template-columns: 1fr;
        }

        .facts__grid {
            grid-template-columns: 1fr 1fr;
        }

        .facts__grid > div:nth-child(3) {
            border-left: 0;
        }

        .facts__grid > div:nth-child(n + 3) {
            border-top: 1px solid var(--line);
        }

        .steps {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 480px) {
        .facts__grid > div {
            padding: 1.5rem 1rem;
        }

        .hero__actions .btn {
            flex: 1 1 100%;
        }
    }
</style>
