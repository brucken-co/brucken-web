---
import BaseLayout from '../layouts/BaseLayout.astro';
import DecisionPanel from '../components/DecisionPanel.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';

const facts = [
    { value: '< 300 ms', label: 'para cada decisão de crédito' },
    { value: 'API REST', label: 'ou troca de arquivos, sem mudar seu armazenamento' },
    { value: 'Bureaus', label: 'e múltiplas fontes de dados integradas' },
    { value: 'Sua política', label: 'sob seu controle, com cada decisão rastreável' },
];

const solutions = [
    {
        tag: 'Consultoria',
        title: 'Consultoria de crédito',
        text: 'Estruturamos sua operação de crédito a partir dos seus dados e do momento do seu negócio.',
        items: [
            'Diagnóstico e política de concessão',
            'Modelagem e critérios de risco',
            'Precificação e régua de cobrança',
        ],
    },
    {
        tag: 'Tecnologia',
        title: 'Motor de decisão',
        text: 'Nossa engine roda dentro da sua plataforma via API. Você define a política; nós executamos cada decisão.',
        items: [
            'Engine embarcada via API REST',
            'Decisões em tempo real (< 300 ms)',
            'Integração com bureaus e fontes próprias',
        ],
    },
    {
        tag: 'Full service',
        title: 'Operação completa',
        text: 'Motor de decisão e gestão da operação juntos, para quem quer oferecer crédito sem montar um time interno.',
        items: [
            'Motor + gestão ponta a ponta',
            'Monitoramento da carteira e indicadores',
            'Calibração contínua dos modelos',
        ],
    },
];

const steps = [
    {
        title: 'Conectamos seus dados',
        text: 'Integramos via API ou arquivos às fontes que você já tem. Você não precisa mudar como armazena seus dados.',
    },
    {
        title: 'O crédito aparece na sua plataforma',
        text: 'Seu cliente pede crédito dentro da sua experiência, com a sua marca. A decisão acontece nos bastidores.',
    },
    {
        title: 'Acompanhamos e ajustamos',
        text: 'Cuidamos da qualidade dos dados e da calibração do motor, e revisamos a estratégia com você.',
    },
];

const sectors = [
    {
        icon: 'Store',
        title: 'Varejo e marketplace',
        text: 'Parcelamento e capital de giro para lojistas e compradores, com base no histórico de vendas na sua plataforma.',
    },
    {
        icon: 'MonitorCog',
        title: 'ERP e SaaS',
        text: 'Crédito oferecido dentro do sistema, usando faturamento e fluxo de caixa que seus clientes já registram.',
    },
    {
        icon: 'Bike',
        title: 'Gig economy',
        text: 'Antecipação e crédito para motoristas e entregadores, a partir do histórico de ganhos na plataforma.',
    },
] as const;
---
<BaseLayout title="Brücken - A ponte entre seus dados e uma nova linha de receita">
    <!-- Hero -->
    <section class="hero">
        <div class="container hero__grid">
            <div class="hero__copy">
                <span class="eyebrow">Crédito embarcado para plataformas</span>
                <h1>A ponte entre seus dados e uma nova linha de receita</h1>
                <p class="hero__lead">
                    A Brücken integra um motor de crédito à sua plataforma e usa os dados que você já tem
                    para oferecer crédito sob medida aos seus clientes — sem construir nada do zero.
                </p>
                <div class="hero__actions">
                    <a href={site.bookingUrl} class="btn btn--primary" target="_blank" rel="noopener noreferrer" data-track="hero">
                        Agendar conversa <Icon name="ArrowRight" size={18} />
                    </a>
                    <a href="#solucoes" class="btn btn--secondary">Ver soluções</a>
                </div>
            </div>
            <div class="hero__visual">
                <DecisionPanel />
            </div>
        </div>
    </section>

    <!-- Fatos -->
    <section class="facts" aria-label="Em números">
        <div class="container">
            <dl class="facts__grid">
                {facts.map((f) => (
                    <div>
                        <dt>{f.value}</dt>
                        <dd>{f.label}</dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>

    <!-- Proposta -->
    <section class="section">
        <div class="container split">
            <div>
                <span class="eyebrow">Por que a Brücken</span>
                <h2 class="split__title">Seus dados já dizem quem pode receber crédito.</h2>
            </div>
            <div class="split__text">
                <p>
                    Plataformas acumulam informação valiosa sobre seus clientes: o que vendem, com que frequência,
                    quanto faturam. Transformar isso em crédito exige um motor de decisão, uma política de risco
                    e gente que saiba calibrar os dois.
                </p>
                <p>
                    A Brücken entrega as três coisas. Você ganha uma nova linha de receita e mantém o
                    relacionamento com o cliente dentro da sua marca.
                </p>
            </div>
        </div>
    </section>

    <!-- Soluções -->
    <section class="section section--subtle" id="solucoes">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Soluções</span>
                <h2>Três formas de trabalhar juntos</h2>
                <p>Da estruturação da política à operação completa, no ritmo do seu negócio.</p>
            </div>
            <div class="solutions">
                {solutions.map((s) => (
                    <article class="solution">
                        <span class="solution__tag">{s.tag}</span>
                        <h3>{s.title}</h3>
                        <p>{s.text}</p>
                        <ul role="list">
                            {s.items.map((item) => (
                                <li><Icon name="Check" size={16} strokeWidth={2} />{item}</li>
                            ))}
                        </ul>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- Como funciona -->
    <section class="section" id="como-funciona">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Como funciona</span>
                <h2>Do dado à decisão em três etapas</h2>
            </div>
            <ol class="steps" role="list">
                {steps.map((step, i) => (
                    <li class="step">
                        <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- Setores -->
    <section class="section section--subtle" id="setores">
        <div class="container">
            <div class="section-head">
                <span class="eyebrow">Setores</span>
                <h2>Sua vertical, sua oferta de crédito</h2>
                <p>Adaptamos o motor e a política aos dados que cada tipo de plataforma já gera.</p>
            </div>
            <div class="sectors">
                {sectors.map((s) => (
                    <article class="sector">
                        <span class="sector__icon"><Icon name={s.icon} size={22} /></span>
                        <h3>{s.title}</h3>
                        <p>{s.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta" id="contato">
        <div class="container cta__inner">
            <div>
                <h2>Vamos avaliar o potencial de crédito da sua base?</h2>
                <p>Uma conversa de 30 minutos com nossos especialistas para entender seus dados e seus clientes.</p>
            </div>
            <div class="cta__actions">
                <a href={site.bookingUrl} class="btn btn--on-dark" target="_blank" rel="noopener noreferrer" data-track="cta">
                    <Icon name="CalendarDays" size={18} /> Agendar conversa
                </a>
                <a href={site.whatsappUrl} class="btn btn--ghost-dark" target="_blank" rel="noopener noreferrer" data-track="cta">
                    <Icon name="MessageCircle" size={18} /> WhatsApp
                </a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Hero */
    .hero {
        padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
        background:
            linear-gradient(to bottom, transparent 70%, var(--bg)),
            radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px;
    }

    .hero__grid {
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        gap: clamp(2.5rem, 2rem + 3vw, 5rem);
        align-items: center;
    }

    .hero h1 {
        font-size: var(--text-3xl);
        letter-spacing: -0.03em;
    }

    .hero__lead {
        margin-top: 1.5rem;
        max-width: 34rem;
        font-size: var(--text-lg);
        color: var(--muted);
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2rem;
    }

    /* Fatos */
    .facts {
        border-block: 1px solid var(--line);
    }

    .facts__grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .facts__grid > div {
        padding: 2rem 1.5rem;
    }

    .facts__grid > div + div {
        border-left: 1px solid var(--line);
    }

    .facts dt {
        color: var(--ink);
        font-size: var(--text-xl);
        font-weight: 600;
        letter-spacing: -0.02em;
    }

    .facts dd {
        margin: 0.375rem 0 0;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    /* Proposta */
    .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(2rem, 1rem + 4vw, 5rem);
    }

    .split__title {
        font-size: var(--text-2xl);
    }

    .split__text {
        font-size: var(--text-lg);
        color: var(--muted);
        display: grid;
        gap: 1.25rem;
        align-content: end;
    }

    /* Soluções */
    .solutions {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .solution {
        display: flex;
        flex-direction: column;
        padding: 2rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
    }

    .solution__tag {
        font-size: var(--text-xs);
        font-weight: 600;
        color: var(--brand-ink);
        margin-bottom: 0.75rem;
    }

    .solution h3 {
        font-size: var(--text-xl);
    }

    .solution p {
        margin-top: 0.75rem;
        color: var(--muted);
        font-size: var(--text-sm);
        flex-grow: 1;
    }

    .solution ul {
        margin-top: 1.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        display: grid;
        gap: 0.625rem;
        font-size: var(--text-sm);
    }

    .solution li {
        display: flex;
        gap: 0.625rem;
        align-items: start;
    }

    .solution li :global(svg) {
        flex: none;
        margin-top: 0.2rem;
        color: var(--brand);
    }

    /* Como funciona */
    .steps {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        padding: 0;
        list-style: none;
    }

    .step {
        padding-top: 1.5rem;
        border-top: 2px solid var(--ink);
    }

    .step__num {
        display: block;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--brand-ink);
        margin-bottom: 1rem;
    }

    .step h3 {
        font-size: var(--text-lg);
    }

    .step p {
        margin-top: 0.75rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    /* Setores */
    .sectors {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .sector {
        padding: 2rem;
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
    }

    .sector__icon {
        display: inline-grid;
        place-items: center;
        width: 44px;
        height: 44px;
        margin-bottom: 1.25rem;
        border-radius: var(--radius);
        background: var(--brand-tint);
        color: var(--brand-ink);
    }

    .sector h3 {
        font-size: var(--text-lg);
    }

    .sector p {
        margin-top: 0.625rem;
        color: var(--muted);
        font-size: var(--text-sm);
    }

    /* CTA */
    .cta {
        background: var(--ink);
        color: #C9D3E0;
        padding-block: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    }

    .cta__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2.5rem;
    }

    .cta h2 {
        color: #fff;
        font-size: var(--text-2xl);
        max-width: 36rem;
    }

    .cta p {
        margin-top: 0.75rem;
        max-width: 36rem;
    }

    .cta__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        flex: none;
    }

    /* Responsivo */
    @media (max-width: 960px) {
        .hero__grid,
        .split {
            grid-template-columns: 1fr;
        }

        .facts__grid {
            grid-template-columns: 1fr 1fr;
        }

        .facts__grid > div:nth-child(3) {
            border-left: 0;
        }

        .facts__grid > div:nth-child(n + 3) {
            border-top: 1px solid var(--line);
        }

        .solutions,
        .sectors,
        .steps {
            grid-template-columns: 1fr;
        }

        .cta__inner {
            flex-direction: column;
            align-items: start;
        }
    }

    @media (max-width: 480px) {
        .facts__grid > div {
            padding: 1.5rem 1rem;
        }

        .hero__actions .btn,
        .cta__actions .btn {
            flex: 1 1 100%;
        }
    }
</style>
