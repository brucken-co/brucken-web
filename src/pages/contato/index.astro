---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactForm from '../../components/ContactForm.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../site';
import { breadcrumbSchema } from '../../schema';

const breadcrumbs = [{ label: 'Início', href: '/' }, { label: 'Contato' }];
const nextSteps = [
    'Analisamos as informações sobre a sua plataforma e a sua base de clientes.',
    `Retornamos em ${site.responseTime}, pelo e-mail informado.`,
    'Se fizer sentido para os dois lados, combinamos os próximos passos.',
];
---
<BaseLayout
    title="Avalie o potencial de crédito da sua plataforma - Brücken"
    description={`Conte um pouco sobre a sua plataforma e a sua base de clientes. A Brücken retorna em ${site.responseTime} com os próximos passos para oferecer crédito embarcado.`}
    schema={[breadcrumbSchema(breadcrumbs, '/contato/')]}
>
    <section class="contact">
        <div class="container">
            <Breadcrumbs items={breadcrumbs} />
            <div class="contact__grid">
                <div class="contact__intro">
                    <span class="eyebrow">Contato</span>
                    <h1>Avalie o potencial de crédito da sua plataforma</h1>
                    <p class="contact__lead">
                        Conte um pouco sobre a sua plataforma e a sua base de clientes. Leva menos de um minuto.
                    </p>

                    <h2>O que acontece depois</h2>
                    <ol class="contact__steps" role="list">
                        {nextSteps.map((step, i) => (
                            <li><span>{String(i + 1).padStart(2, '0')}</span>{step}</li>
                        ))}
                    </ol>

                    <p class="contact__alt">
                        Prefere conversar agora?
                        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" data-track="contato">
                            <Icon name="MessageCircle" size={16} /> Fale pelo WhatsApp
                        </a>
                    </p>
                </div>

                <div class="contact__card">
                    <ContactForm />
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .contact {
        padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) var(--space-section);
        background:
            linear-gradient(to bottom, transparent 30%, var(--bg)),
            radial-gradient(var(--line) 1px, transparent 1px) 0 0 / 24px 24px;
    }

    .contact__grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: clamp(2.5rem, 2rem + 3vw, 5rem);
        margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
        align-items: start;
    }

    .contact h1 {
        font-size: var(--text-3xl);
        letter-spacing: -0.03em;
    }

    .contact__lead {
        margin-top: 1.25rem;
        font-size: var(--text-lg);
        color: var(--muted);
    }

    .contact__intro h2 {
        margin-top: 2.5rem;
        font-size: var(--text-lg);
    }

    .contact__steps {
        display: grid;
        gap: 1rem;
        margin-top: 1rem;
        padding: 0;
        list-style: none;
    }

    .contact__steps li {
        display: flex;
        gap: 1rem;
        color: var(--ink-2);
    }

    .contact__steps span {
        flex: none;
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        color: var(--brand-ink);
        padding-top: 0.15rem;
    }

    .contact__alt {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: var(--text-sm);
    }

    .contact__alt a {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        margin-left: 0.25rem;
        font-weight: 600;
    }

    .contact__card {
        padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--radius-lg);
        box-shadow: 0 1px 2px rgba(15, 27, 45, 0.04), 0 24px 48px -24px rgba(15, 27, 45, 0.18);
    }

    @media (max-width: 960px) {
        .contact__grid {
            grid-template-columns: 1fr;
        }
    }
</style>
